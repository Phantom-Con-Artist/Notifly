{
  "name": "notifly",
  "version": "1.0.1",
  "description": "Capture thoughts, files and voice notes from anywhere, even when the app is closed.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node daemon/ui/build.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "build:popup": "node daemon/ui/build.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "quick-capture",
    "note-taking",
    "inbox",
    "voice-notes",
    "markdown",
    "pdf",
    "global-shortcut",
    "wikilinks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9.39.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "private": true,
  "author": {
    "name": "Subhradeep Sarkar",
    "url": "https://github.com/Phantom-Con-Artist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantom-Con-Artist/Notifly.git"
  },
  "bugs": {
    "url": "https://github.com/Phantom-Con-Artist/Notifly/issues"
  },
  "homepage": "https://github.com/Phantom-Con-Artist/Notifly#readme"
}
